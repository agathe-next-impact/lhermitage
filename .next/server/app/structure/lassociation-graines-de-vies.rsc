2:["$","div",null,{"className":"container mx-auto px-4 py-12","children":[["$","div",null,{"className":"mb-12","children":[["$","h1",null,{"className":"mb-4 font-serif text-4xl font-extrabold uppercase md:text-5xl","children":"L’association Graines de vies"}],["$","div",null,{"className":"prose prose-stone mb-8 max-w-none","dangerouslySetInnerHTML":{"__html":"<strong>Graines de vies, c’est l’AMAP de la Vallée</strong> (Association pour le maintien d’une agriculture paysanne)\r\n\r\nElle soutient les producteurs et organise des évènements\r\n<ul>\r\n \t<li aria-level=\"1\"><strong>Distribution hebdomadaire de paniers bios</strong> le mardi à la Mère Mitage entre 17h30 et 19h (légumes, oeufs, fromage de chèvre et achats groupés ponctuels)</li>\r\n</ul>\r\n<div></div>\r\n<ul>\r\n \t<li aria-level=\"1\"><strong>Organisation d’activités et événements autour de l’alimentation</strong> : Le Marché Enchanté de décembre, la marche gourmande du Trail des Hermites, Concert annuel, Brocante du village</li>\r\n</ul>"}}],""]}],["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"mb-6 font-serif text-3xl font-extrabold uppercase","children":"Photos"}],["$","div",null,{"className":"grid gap-4 md:grid-cols-2 lg:grid-cols-3","children":[["$","div","272",{"className":"relative h-64 overflow-hidden rounded-lg","children":["$","$La",null,{"src":"https://wp-asso.com/wp-content/uploads/2025/11/ASSO-et-PLANTEURS-atelier-fonction-des-haies-seches-2024-1080x810-1.webp","alt":"Photo 1","fill":true,"className":"object-cover"}]}]]}]]}],"",false,["$","section",null,{"className":"rounded-lg bg-muted p-8 text-center","children":[["$","h2",null,{"className":"mb-4 font-serif text-2xl font-bold","children":"Intéressé par cette structure ?"}],["$","p",null,{"className":"mb-6 text-muted-foreground","children":"Contactez-nous pour en savoir plus"}],["$","$Lb",null,{"href":"/infos-pratiques/contacts","children":"Nous contacter","data-slot":"button","className":"inline-flex it