2:["$","div",null,{"className":"container mx-auto px-4 py-12","children":[["$","div",null,{"className":"mb-12","children":[["$","h1",null,{"className":"mb-4 font-serif text-4xl font-extrabold uppercase md:text-5xl","children":"HERMITAGE Expérimentations"}],["$","div",null,{"className":"prose prose-stone mb-8 max-w-none","dangerouslySetInnerHTML":{"__html":"L’association c’est le lieu d’accueil de l’Hermitage . <strong>Un Espace de Vie Sociale pour toutes et tous dans la Vallée! </strong> Autour de 3 grands thèmes : l’alimentation , le vivre ensemble  et la biodiversité.\r\n\r\nC’est aussi la possibilité d’accueillir vos structures autour d’animations\r\n\r\nÀ l’association vous pouvez venir boire un café, rêver d’un autre monde , papoter , chanter lors d’un karaoké , ou apprendre.\r\n\r\n<b>Horaires d’ouverture</b> : mardi 9h30-20h / mercredi, jeudi, vendredi 9h30-18h et lors de nos événements\r\n\r\n<b>Cantine le midi du mardi au vendredi sur réservation</b> : <a href=\"mailto:cafe@hermitagelelab.com\"><strong>cafe@hermitagelelab.com</strong></a> ou <a href=\"tel:0634502963\">06 34 50 29 63</a> (formule repas bio, local et de saison à 12€, large choix de boissons)"}}],""]}],["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"mb-6 font-serif text-3xl font-extrabold uppercase","children":"Photos"}],["$","div",null,{"className":"grid gap-4 md:grid-cols-2 lg:grid-cols-3","children":[["$","div","124",{"className":"relative h-64 overflow-hidden rounded-lg","children":["$","$La",null,{"src":"https://wp-asso.com/wp-content/uploads/2025/10/ASS0-visite-du-bois-2024-1536x1025-1.webp","alt":"Photo 1","fill":true,"className":"object-cover"}]}],["$","div","125",{"className":"relative h-64 overflow-hidden rounded-lg","children":["$","$La",null,{"src":"https://wp-asso.com/wp-content/uploads/2025/10/ASSO-bar-la-Mere-Mitage-Portes-ouvertes-2023-1536x1025-1.webp","alt":"Photo 2","fill":true,"className":"object-cover"}]}],["$","div","126",{"className":"relative h-64 overflow-hidden rounded-lg","children":["$","$La",null,{"src":"https://wp-asso.com/wp-content/uploads/2025/10/ASSO-sortie-des-Gastounettes-a-lESCALE-PFE-aout-24-1-1536x867-1.webp","alt":"Photo 3","fill":true,"className":"object-cover"}]}],["$","div","127",{"className":"relative h-64 overflow-hidden rounded-lg","children":["$","$La",null,{"src":"https://wp-asso.com/wp-content/uploads/2025/10/WhatsApp-Image-2025-02-19-a-09.40.jpg","alt":"Photo 4","fill":true,"className":"object-cover"}]}]]}]]}],["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"mb-6 font-serif text-3xl font-extrabold uppercase","children":"Vidéo"}],["$","div",null,{"className":"aspect-video overflow-hidden rounded-lg","children":["$","div",null,{"dangerouslySetInnerHTML":{"__html":"<iframe title=\"Les travaux du Café-cantine sont lancés !\" width=\"640\" height=\"360\" src=\"https://www.youtube.com/embed/9tZ0PpSqBMc?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>"}}]}]]}],["$","section",null,{"className":"mb-12","children":[["$","h2",null,{"className":"mb-6 font-serif text-3xl font-extrabold uppercase","children":"Localisation"}],["$","div",null,{"data-slot":"card","className":"bg-card text-card-foreground flex flex-col gap-6 rounded-xl border py-6 shadow-sm","children":["$","div",null,{"data-slot":"card-content","className":"p-6","children":["$","div",null,{"className":"flex items-start gap-4","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-map-pin h-6 w-6 text-primary","children":[["$","path","1r0f0z",{"d":"M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0