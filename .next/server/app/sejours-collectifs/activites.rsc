utter_speed":"0","title":"","orientation":"0","keywords":[]}},"source_url":"https://wp-asso.com/wp-content/uploads/2025/10/WhatsApp-Image-2025-02-14-a-16.55.31_29c7f276.jpg","_links":{"self":[{"href":"https://wp-asso.com/wp-json/wp/v2/media/132","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://wp-asso.com/wp-json/wp/v2/media"}],"about":[{"href":"https://wp-asso.com/wp-json/wp/v2/types/attachment"}],"author":[{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/users/1"}],"replies":[{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/comments?post=132"}],"wp:attached-to":[{"embeddable":true,"post_type":"page","id":94,"href":"https://wp-asso.com/wp-json/wp/v2/pages/94"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}],"wp:term":[[{"id":7,"link":"https://wp-asso.com/category/atelier-de-facilitation/","name":"Atelier de facilitation","slug":"atelier-de-facilitation","taxonomy":"category","acf":[],"_links":{"self":[{"href":"https://wp-asso.com/wp-json/wp/v2/categories/7","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://wp-asso.com/wp-json/wp/v2/categories"}],"about":[{"href":"https://wp-asso.com/wp-json/wp/v2/taxonomies/category"}],"wp:post_type":[{"href":"https://wp-asso.com/wp-json/wp/v2/posts?categories=7"},{"href":"https://wp-asso.com/wp-json/wp/v2/activite?categories=7"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}]]}},{"id":184,"date":"2025-10-27T08:49:45","date_gmt":"2025-10-27T08:49:45","guid":{"rendered":"https://wp-asso.com/?post_type=activite&p=184"},"modified":"2025-10-27T08:49:45","modified_gmt":"2025-10-27T08:49:45","slug":"visite-dun-ecolieu-zero-dechets","status":"publish","type":"activite","link":"https://wp-asso.com/activite/visite-dun-ecolieu-zero-dechets/","title":{"rendered":"Visite d'un Ecolieu zéro déchets"},"featured_media":185,"template":"","meta":{"_acf_changed":false},"categories":[6],"class_list":["post-184","activite","type-activite","status-publish","has-post-thumbnail","hentry","category-zero-dechets"],"acf":{"nom":"Visite d'un Ecolieu zéro déchets","descriptif":"<p><em><strong>A 15 minutes de l'Hermitage</strong></em></p>\n<p>A cette occasion vous entrerez dans un lieu dont l'objectif est de devenir écologiquement et économiquement autonome. Vous découvrirez une autre façon de vivre et de consommer grâce à différentes techniques mises en place : habitat léger équipé d'un système de récupération d'eau de pluie et d'assainissement autonome, toilettes sèches, espace permaculture, atelier couture zéro déchets, rucher, épicerie vrac local : « Du local au bocal » y compris atelier Tawashi.</p>\n<p><strong>Être véhiculé</strong><br />\n<strong>2h</strong><br />\n<strong>Tarif : 55€ HT par personne</strong></p>\n"},"_links":{"self":[{"href":"https://wp-asso.com/wp-json/wp/v2/activite/184","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://wp-asso.com/wp-json/wp/v2/activite"}],"about":[{"href":"https://wp-asso.com/wp-json/wp/v2/types/activite"}],"wp:featuredmedia":[{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/media/185"}],"wp:attachment":[{"href":"https://wp-asso.com/wp-json/wp/v2/media?parent=184"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/categories?post=184"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]},"_embedded":{"wp:featuredmedia":[{"id":185,"date":"2025-10-27T08:49:21","slug":"village_de_tiny-14-595cb","type":"attachment","link":"https://wp-asso.com/activite/visite-dun-ecolieu-zero-dechets/village_de_tiny-14-595cb/","title":{"rendered":"village_de_tiny-14-595cb"},"author":1,"featured_media":0,"acf":[],"caption":{"rendered":""},"alt_text":"","media_type":"image","mime_type":"image/jpeg","media_details":{"width":720,"height":480,"file":"2025/10/village_de_tiny-14-595cb.jpg","filesize":488024,"sizes":{"medium":{"file":"village_de_tiny-14-595cb-300x200.jpg","width":300,"height":200,