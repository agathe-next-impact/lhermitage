/activite"}],"wp:featuredmedia":[{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/media/181"}],"wp:attachment":[{"href":"https://wp-asso.com/wp-json/wp/v2/media?parent=180"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/categories?post=180"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]},"_embedded":{"wp:featuredmedia":[{"id":181,"date":"2025-10-27T08:26:31","slug":"zero-waste","type":"attachment","link":"https://wp-asso.com/activite/la-conference/zero-waste/","title":{"rendered":"zero-waste"},"author":1,"featured_media":0,"acf":[],"caption":{"rendered":""},"alt_text":"","media_type":"image","mime_type":"image/jpeg","media_details":{"width":900,"height":599,"file":"2025/10/zero-waste.jpg","filesize":154741,"sizes":{"medium":{"file":"zero-waste-300x200.jpg","width":300,"height":200,"filesize":17748,"mime_type":"image/jpeg","source_url":"https://wp-asso.com/wp-content/uploads/2025/10/zero-waste-300x200.jpg"},"thumbnail":{"file":"zero-waste-150x150.jpg","width":150,"height":150,"filesize":8630,"mime_type":"image/jpeg","source_url":"https://wp-asso.com/wp-content/uploads/2025/10/zero-waste-150x150.jpg"},"medium_large":{"file":"zero-waste-768x511.jpg","width":768,"height":511,"filesize":89882,"mime_type":"image/jpeg","source_url":"https://wp-asso.com/wp-content/uploads/2025/10/zero-waste-768x511.jpg"},"full":{"file":"zero-waste.jpg","width":900,"height":599,"mime_type":"image/jpeg","source_url":"https://wp-asso.com/wp-content/uploads/2025/10/zero-waste.jpg"}},"image_meta":{"aperture":"0","credit":"","camera":"","caption":"","created_timestamp":"0","copyright":"","focal_length":"0","iso":"0","shutter_speed":"0","title":"","orientation":"0","keywords":[]}},"source_url":"https://wp-asso.com/wp-content/uploads/2025/10/zero-waste.jpg","_links":{"self":[{"href":"https://wp-asso.com/wp-json/wp/v2/media/181","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://wp-asso.com/wp-js