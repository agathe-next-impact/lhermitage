9:["$","header",null,{"className":"fixed top-0 z-40 w-full bg-transparent","children":["$","$La",null,{"centerLogo":"/logo-arcs-coral.png","centerLogoAlt":"Logo ARCS","items":[{"label":"L’Hermitage","bgColor":"#2A4A51","textColor":"#ffffff","links":[]},{"label":"Séjours collectifs","bgColor":"#56939F","textColor":"#ffffff","links":[{"label":"Nos séjours","href":"/sejours-collectifs/nos-sejours/","ariaLabel":"Voir Nos séjours"},{"label":"Hébergements","href":"/hebergements/","ariaLabel":"Voir Hébergements"},{"label":"Activités","href":"/sejours-collectifs/activites/","ariaLabel":"Voir Activités"},{"label":"Services","href":"/sejours-collectifs/services/","ariaLabel":"Voir Services"}]},{"label":"Ecosystème innovant","bgColor":"#78AD7D","textColor":"#ffffff","links":[{"label":"Partenaires","href":"/ecosysteme-innovant/partenaires/","ariaLabel":"Voir Partenaires"},{"label":"Structures hébergées","href":"/ecosysteme-innovant/structures-hebergees/","ariaLabel":"Voir Structures hébergées"},{"label":"Evénements","href":"/ecosysteme-innovant/evenements/","ariaLabel":"Voir Evénements"}]},{"label":"Tiers-Lieu rural","bgColor":"#C14C66","textColor":"#ffffff","links":[{"label":"Le concept","href":"/tiers-lieu-rural/le-concept/","ariaLabel":"Voir Le concept"},{"label":"L’histoire du lieu","href":"/tiers-lieu-rural/lhistoire-du-lieu/","ariaLabel":"Voir L’histoire du lieu"},{"label":"L’équipe","href":"/tiers-lieu-rural/lequipe/","ariaLabel":"Voir L’équipe"},{"label":"Le domaine","href":"/tiers-lieu-rural/le-domaine/","ariaLabel":"Voir Le domaine"}]},{"label":"Infos pratiques","bgColor":"#DC6F45","textColor":"#ffffff","links":[{"label":"Localisation","href":"/infos-pratiques/localisation/","ariaLabel":"Voir Localisation"},{"label":"Jours et horaires d’ouverture","href":"/infos-pratiques/jours-et-horaires-douverture/","ariaLabel":"Voir Jours et horaires d’ouverture"},{"label":"Contacts","href":"/infos-pratiques/contacts/","ariaLabel":"Voir Contacts"}]},{"label":"Participer","bgColor":"#E75754","textColor":"#ffffff","links":[{"label":"Devenir sociétaire","href":"/participer/devenir-societaire/","ariaLabel":"Voir Devenir sociétaire"},{"label":"Faire un don","href":"/participer/faire-un-don/","ariaLabel":"Voir Faire un don"},{"label":"Travailler avec nous","href":"/participer/travailler-avec-nous/","ariaLabel":"Voir Travailler avec nous"}]},{"label":"Découvrir","bgColor":"#DC6F45","textColor":"#ffffff","image":"/rural-retreat-hermitage-building-nature.jpg","imageAlt":"Vue de l'Hermitage","ctaLabel":"Découvrir le lieu","ctaHref":"/visite-virtuelle","ctaTarget":"","cta2Label":"Construire son séjour","cta2Href":"/reserver/","cta2Target":""}],"baseColor":"#ffffff","menuColor":"#535353","buttonBgColor":"#E75754","buttonTextColor":"#ffffff","ctaLabel":"Réserver","ctaHref":"/sejours-collectifs/reserver/","ctaTarget":"","ease":"power3.out"}]}]
