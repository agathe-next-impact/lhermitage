pg"},"full":{"file":"WhatsApp-Image-2025-01-20-a-17.01.59_76d635c6.jpg","width":469,"height":686,"mime_type":"image/jpeg","source_url":"https://wp-asso.com/wp-content/uploads/2025/10/WhatsApp-Image-2025-01-20-a-17.01.59_76d635c6.jpg"}},"image_meta":{"aperture":"0","credit":"","camera":"","caption":"","created_timestamp":"0","copyright":"","focal_length":"0","iso":"0","shutter_speed":"0","title":"","orientation":"0","keywords":[]}},"source_url":"https://wp-asso.com/wp-content/uploads/2025/10/WhatsApp-Image-2025-01-20-a-17.01.59_76d635c6.jpg","_links":{"self":[{"href":"https://wp-asso.com/wp-json/wp/v2/media/260","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://wp-asso.com/wp-json/wp/v2/media"}],"about":[{"href":"https://wp-asso.com/wp-json/wp/v2/types/attachment"}],"author":[{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/users/1"}],"replies":[{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/comments?post=260"}],"wp:attached-to":[{"embeddable":true,"post_type":"page","id":487,"href":"https://wp-asso.com/wp-json/wp/v2/pages/487"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]}}]}},{"id":142,"date":"2025-10-27T03:01:21","date_gmt":"2025-10-27T03:01:21","guid":{"rendered":"https://wp-asso.com/?post_type=hebergement&p=142"},"modified":"2025-11-11T15:04:47","modified_gmt":"2025-11-11T15:04:47","slug":"les-cabanes","status":"publish","type":"hebergement","link":"https://wp-asso.com/hebergement/les-cabanes/","title":{"rendered":"Les cabanes"},"featured_media":145,"template":"","meta":{"_acf_changed":false},"class_list":["post-142","hebergement","type-hebergement","status-publish","has-post-thumbnail","hentry"],"acf":{"nom":"Les cabanes","descriptif":"<p>Après des portes ouvertes en mai dernier ayant rassemblé plus de 700 personnes autour de 40 ateliers, puis une campagne de crowdfunding inédite en France pour un projet de société ayant rassemblé 1220 contributeurs autour de 102381€, l'équipe du Lab Hermitage a réussi sa preuve de concept. Elle s'atèle aujourd'hui à une année de préfiguration pour lancer le projet Hermitage en 2018. Les défis sont nombreux, développement de la dynamique associative, définition d'un modèle économique solide, recherche de partenaires, autant de challenges pour pérenniser le projet.</p>\n","photos":[{"ID":147,"id":147,"title":"WhatsApp Image 2024-12-19 à 10.32.23_eabc1031","filename":"WhatsApp-Image-2024-12-19-a-10.32.23_eabc1031.jpg","filesize":224602,"url":"https://wp-asso.com/wp-content/uploads/2025/10/WhatsApp-Image-2024-12-19-a-10.32.23_eabc1031.jpg","link":"https://wp-asso.com/hebergement/les-cabanes/whatsapp-image-2024-12-19-a-10-32-23_eabc1031/","alt":"","author":"1","description":"","caption":"","name":"whatsapp-image-2024-12-19-a-10-32-23_eabc1031","status":"inherit","uploaded_to":142,"date":"2025-10-27 02:34:27","modified":"2025-10-27 02:34:27","menu_order":0,"mime_type":"image/jpeg","type":"image","subtype":"jpeg","icon":"https://wp-asso.com/wp-includes/images/media/default.png","width":900,"height":1600,"sizes":{"thumbnail":"https://wp-asso.com/wp-content/uploads/2025/10/WhatsApp-Image-2024-12-19-a-10.32.23_eabc1031-150x150.jpg","thumbnail-width":150,"thumbnail-height":150,"medium":"https://wp-asso.com/wp-content/uploads/2025/10/WhatsApp-Image-2024-12-19-a-10.32.23_eabc1031-169x300.jpg","medium-width":169,"medium-height":300,"medium_large":"https://wp-asso.com/wp-content/uploads/2025/10/WhatsApp-Image-2024-12-19-a-10.32.23_eabc1031-768x1365.jpg","medium_large-width":640,"medium_large-height":1138,"large":"https://wp-asso.com/wp-content/uploads/2025/10/WhatsApp-Image-2024-12-19-a-10.32.23_eabc1031-576x1024.jpg","large-width":576,"large-height":1024,"1536x1536":"https://wp-asso.com/wp-content/uploads/2025/10/WhatsApp-Image-2024-12-19-a-10.32.23_eabc1031-864x1536.jpg","1536x1536-width":864,"1536x1536-height":1536,"2048x2048":"https://wp-asso.com/wp-content/uploads/2025/10/WhatsApp-Image-2024-12-19-a-10.32.23_eabc1031.jpg","204