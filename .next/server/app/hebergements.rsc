eddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/media/143"},{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/media/144"},{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/media/145"},{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/media/146"},{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/media/147"}],"wp:featuredmedia":[{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/media/145"}],"wp:attachment":[{"href":"https://wp-asso.com/wp-json/wp/v2/media?parent=142"}],"curies":[{"name":"wp","href":"https://api.w.org/{rel}","templated":true}]},"_embedded":{"acf:post":[{"id":142,"date":"2025-10-27T03:01:21","slug":"les-cabanes","type":"hebergement","link":"https://wp-asso.com/hebergement/les-cabanes/","title":{"rendered":"Les cabanes"},"featured_media":145,"acf":{"nom":"Les cabanes","descriptif":"Après des portes ouvertes en mai dernier ayant rassemblé plus de 700 personnes autour de 40 ateliers, puis une campagne de crowdfunding inédite en France pour un projet de société ayant rassemblé 1220 contributeurs autour de 102381€, l'équipe du Lab Hermitage a réussi sa preuve de concept. Elle s'atèle aujourd'hui à une année de préfiguration pour lancer le projet Hermitage en 2018. Les défis sont nombreux, développement de la dynamique associative, définition d'un modèle économique solide, recherche de partenaires, autant de challenges pour pérenniser le projet.","photos":[147,146,145,144,143],"video":"","visibilite":true,"images":[147,146,145,144,143],"lien":142,"position":{"latitude":49.438346,"longitude":3.127649,"altitude":""}},"_links":{"self":[{"href":"https://wp-asso.com/wp-json/wp/v2/hebergement/142","targetHints":{"allow":["GET"]}}],"collection":[{"href":"https://wp-asso.com/wp-json/wp/v2/hebergement"}],"about":[{"href":"https://wp-asso.com/wp-json/wp/v2/types/hebergement"}],"acf:post":[{"embeddable":true,"href":"https://wp-asso.com/wp-json/wp/v2/hebergement/142"}],"acf:attachment":[{"embeddable":true,"hr