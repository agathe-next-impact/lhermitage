# ========================================
# CONFIGURATION DE L'ENVIRONNEMENT
# ========================================
# Copiez ce fichier en .env.local et remplissez les valeurs
# cp .env.example .env.local

# ========================================
# WORDPRESS API (OBLIGATOIRE)
# ========================================
# URL de l'API REST WordPress (server-side only)
# Format: https://votre-domaine.com/wp-json/wp/v2
WP_API_URL=https://admin.hermitagelelab.com/wp-json/wp/v2

# URL de l'API GraphQL WordPress (optionnel, server-side only)
# Format: https://votre-domaine.com/graphql
# Par défaut: https://admin.hermitagelelab.com/graphql
WP_GRAPHQL_URL=https://admin.hermitagelelab.com/graphql


# ========================================
# SEO & METADATA (OPTIONNEL)
# ========================================
# URL complète du site pour les métadonnées SEO (server-side only)
# Utilisé pour générer les URLs canoniques et Open Graph
# Par défaut: https://hermitagelelab.com
SITE_URL=https://v0-headless-word-press-app.vercel.app/

# ========================================
# WORDPRESS PAGE IDS (OPTIONNEL)
# ========================================
# ID de la page d'accueil dans WordPress
# Pour trouver l'ID : Admin WordPress > Pages > Modifier la page > URL contient post=ID
HOMEPAGE_ID=138

# URL de fallback pour le CTA de la barre supérieure (utilisé si GraphQL échoue)
DEFAULT_CTA_URL=/contact

# ========================================
# REVALIDATION ON-DEMAND (OPTIONNEL)
# ========================================
# Secret partagé entre WordPress et Next.js pour la revalidation on-demand
# Configurer un webhook WordPress pour POST /api/revalidate avec ce secret
# Header: x-revalidation-secret: <votre-secret>
REVALIDATION_SECRET=aUK3rj0ag+NjTi0/1ym8bBdFpJCTRopVuosBAbFA7OA=


# ========================================
# ENVIRONNEMENT (GÉRÉ AUTOMATIQUEMENT)
# ========================================
# L'environnement est automatiquement défini par Next.js
# development | production | test
# NODE_ENV=development
